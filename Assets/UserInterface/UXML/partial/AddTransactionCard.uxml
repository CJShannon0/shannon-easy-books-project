<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UserInterface/CSS/style.uss?fileID=7433441132597879392&amp;guid=7f29b78d9de3572409fe914fc6b8af43&amp;type=3#style"/>
    <ui:VisualElement name="" class="Canvas">
        <ui:VisualElement class="Horizontal" style="flex-grow: 1;">
            <ui:Label text="Add a Transaction"/>
            <ui:VisualElement class="Horizontal" style="flex-grow: 1; justify-content: flex-end;">
                <ui:Button text="Add" name="AddTransactionButton"/>
                <ui:Button text="Cancel" name="CancelButton"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:TextField label="Vendor" placeholder-text="enter here..." name="VendorField"/>
        <ui:TextField label="Date" placeholder-text="MM/DD/YYYY" name="DateField"/>
        <ui:FloatField label="Amount" value="0" name="AmountField" placeholder-text="0.00"/>
        <ui:DropdownField label="Category" name="CategoryField"/>
        <ui:TextField label="Notes" placeholder-text="enter here..." name="NotesField"/>
    </ui:VisualElement>
</ui:UXML>
